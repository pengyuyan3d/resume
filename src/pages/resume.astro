---
import { siteConfig } from "../config";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const edu = siteConfig.education[0];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{siteConfig.name} · 简历（一页版）</title>
    <style is:global>
      @page {
        size: A4;
        margin: 10mm 12mm;
      }

      body {
        margin: 0;
        background: #fff !important;
        color: #111 !important;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Noto Sans CJK SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: visible !important;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .ext-link {
        color: #b54025;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      .rule {
        height: 1px;
        background: #dcdfe5;
      }

      h1,
      h2,
      h3,
      p,
      ul {
        margin: 0;
      }

      ul {
        padding: 0;
        list-style: none;
      }

      .avoid {
        break-inside: avoid;
      }

      @media screen {
        body {
          background: #eceef2;
        }

        .sheet {
          box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.45);
          margin: 32px auto;
          max-width: 820px;
          padding: 36px 42px;
          background: #fff;
        }
      }

      @media print {
        .sheet {
          padding: 0;
          margin: 0;
          max-width: none;
          box-shadow: none;
        }
      }
    </style>
  </head>

  <body>
    <main class="sheet">
      <!-- 抬头 -->
      <header class="flex items-start justify-between gap-6">
        <div>
          <h1 class="text-[29px] font-bold leading-none tracking-[-0.02em]">
            {siteConfig.name}
          </h1>
          <p class="mt-2 text-[13px] font-semibold text-[#222]">
            全栈开发工程师 <span class="text-[#666]">· AI 应用与产品闭环</span>
          </p>
          <p class="mt-1.5 text-[9.5px] font-medium text-[#b54025]">
            国家奖学金 · 专业 Top 5% · 福建省大学生数学竞赛一等奖
          </p>
        </div>
        <div class="mono mt-0.5 space-y-0.5 text-right text-[10px] leading-relaxed text-[#333]">
          <p>{siteConfig.phoneFormatted} · <a href={`mailto:${siteConfig.social.email}`}>{siteConfig.social.email}</a></p>
          <p>{siteConfig.location} · 2026 届本科 · 随时到岗</p>
          <p>
            在线作品集与可玩 Demo：<a class="ext-link" href={siteConfig.portfolioUrl}>pengyuyan3d.github.io/resume</a>
          </p>
          <p>
            GitHub：<a class="ext-link" href={siteConfig.social.github}>github.com/pengyuyan3d</a>
          </p>
        </div>
      </header>

      <div class="rule mt-3.5"></div>

      <!-- 概述 -->
      <section class="avoid mt-3.5">
        <p class="text-[9.8px] leading-[1.72] text-[#2b3038]">{siteConfig.aboutMe}</p>
      </section>

      <div class="mt-3.5 grid grid-cols-[1.68fr_1fr] gap-6">
        <!-- 左：研发经历（隐去起止时间，聚焦工程交付） -->
        <section>
          <h2 class="mono text-[9.5px] font-semibold uppercase tracking-[0.14em] text-[#7a828e]">
            Experience · 研发与交付经历
          </h2>
          <div class="mt-2 space-y-2.5">
            {
              siteConfig.experience.map((job) => (
                <article class="avoid border-t border-[#e5e7ec] pt-2 first:border-0 first:pt-0">
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    <h3 class="text-[10.8px] font-bold text-[#181c22]">{job.company}</h3>
                    <span class="text-[9.8px] font-medium text-[#555]">{job.title}</span>
                  </div>
                  <ul class="mt-1 space-y-1">
                    {job.bullets.map((b) => (
                      <li class="flex gap-1.5 text-[9.3px] leading-[1.62] text-[#353b45]">
                        <span class="mt-[6px] h-[3px] w-[3px] shrink-0 rounded-full bg-[#b54025]" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <!-- 右：技能 / 教育 -->
        <div class="space-y-3.5">
          <section class="avoid">
            <h2 class="mono text-[9.5px] font-semibold uppercase tracking-[0.14em] text-[#7a828e]">
              Skills · 技术栈
            </h2>
            <ul class="mt-2 flex flex-wrap gap-1">
              {siteConfig.skills.map((s) => (
                <li class="rounded border border-[#dde1e7] bg-[#fafbfc] px-1.5 py-0.5 text-[8.8px] font-medium text-[#353b45]">
                  {s}
                </li>
              ))}
            </ul>
          </section>

          <section class="avoid">
            <h2 class="mono text-[9.5px] font-semibold uppercase tracking-[0.14em] text-[#7a828e]">
              Education · 教育与荣誉
            </h2>
            <div class="mt-2">
              <div class="flex items-baseline justify-between gap-2">
                <p class="text-[10.5px] font-bold text-[#181c22]">{edu.school}</p>
                <span class="mono text-[8.8px] text-[#7a828e]">{edu.dateRange}</span>
              </div>
              <p class="mt-0.5 text-[9.5px] text-[#353b45]">{edu.degree}</p>
              <ul class="mt-1 space-y-0.5">
                {edu.achievements.map((a) => (
                  <li class="text-[9px] leading-[1.58] text-[#353b45]">· {a}</li>
                ))}
              </ul>
            </div>
          </section>
        </div>
      </div>

      <!-- 代表项目 -->
      <section class="avoid mt-3.5">
        <h2 class="mono text-[9.5px] font-semibold uppercase tracking-[0.14em] text-[#7a828e]">
          Selected Projects · 代表作与架构落地
        </h2>
        <div class="mt-2 grid grid-cols-2 gap-x-5 gap-y-2.5">
          {
            siteConfig.projects.map((p) => (
              <article class="avoid">
                <div class="flex items-baseline justify-between gap-2">
                  <h3 class="text-[10.2px] font-bold leading-snug text-[#181c22]">{p.name}</h3>
                  {p.link && (
                    <a class="ext-link mono shrink-0 text-[8.5px]" href={p.link}>
                      {p.linkLabel || "在线预览"} ↗
                    </a>
                  )}
                </div>
                <p class="mt-0.5 text-[8.9px] leading-[1.58] text-[#353b45]">{p.description}</p>
                <p class="mono mt-0.5 text-[8.3px] text-[#7a828e]">{p.skills.join(" · ")}</p>
              </article>
            ))
          }
        </div>
      </section>

      <div class="rule mt-3.5"></div>
      <p class="mono mt-1.5 flex items-center justify-between text-[8px] text-[#8a919c]">
        <span>
          {siteConfig.name} · 交互式作品集（含在线可运行 Demo 与架构复盘）：<a class="ext-link" href={siteConfig.portfolioUrl}>pengyuyan3d.github.io/resume</a>
        </span>
        <span>更新于 {new Date().toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit" })}</span>
      </p>
    </main>
  </body>
</html>
