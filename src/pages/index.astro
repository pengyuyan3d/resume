---
import Stage from "../components/island/Stage.astro";
import Panels from "../components/island/Panels.astro";
import IndexSection from "../components/island/IndexSection.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
import "../styles/island.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = `${siteConfig.name} · 产品型全栈开发 | 雨岛 3D 作品集`;
const desc =
  "张雨的作品集与简历：产品型全栈开发工程师（国家奖学金 / Top 5%）。Three.js 柔和光影 3D 浮空雨岛、双王牌可交互全栈代表作与在线一页简历。";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#f5f8f7" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={`${base}/og-cover.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: siteConfig.name,
        jobTitle: siteConfig.title,
        email: `mailto:${siteConfig.social.email}`,
        telephone: siteConfig.phone,
        url: siteConfig.portfolioUrl,
        address: { "@type": "PostalAddress", addressLocality: "北京", addressCountry: "CN" },
        sameAs: [siteConfig.social.github],
        alumniOf: { "@type": "CollegeOrUniversity", name: "福建理工大学" },
      })}
    />
  </head>
  <body class="island-page">
    <header class="floating-header" id="header">
      <div class="nav-pill">
        <a href={`${base}/`} class="brand-link">
          <span class="brand-name">张雨</span>
          <span class="brand-tag">产品型全栈 · 雨岛</span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a class="nav-link" href="#works">代表作</a>
          <a class="nav-link" href="#experience">研发经历</a>
          <a class="nav-link" href={`${base}/profile/`}>长版简历</a>
        </nav>
        <a class="btn btn-primary btn-nav" href={`${base}/resume.pdf`} download>
          简历 PDF
        </a>
      </div>
    </header>

    <main>
      <Stage />
      <IndexSection />

      <section class="section" id="contact" style="padding-top:0">
        <div class="cta-banner">
          <div>
            <p class="eyebrow">开放机会 · 北京</p>
            <h2 class="cta-title">随时到岗，期待一起把好点子做成上线产品</h2>
            <p class="cta-desc">
              2026 届本科 · 国家奖学金（专业 Top 5%） · 产品型全栈开发 / 企业级 AI 应用 / Python·Go 后端
            </p>
          </div>
          <div class="cta-actions">
            <a class="btn btn-primary" href={`mailto:${siteConfig.social.email}`}>发送邮件</a>
            <button class="btn btn-glass" type="button" data-copy={siteConfig.social.email}>
              复制邮箱
            </button>
            <a class="btn btn-glass" href={`${base}/resume.pdf`} download>一页简历 PDF</a>
            <a class="btn btn-glass" href="https://github.com/pengyuyan3d" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© 2026 张雨 · Three.js 低多边形光影浮空岛 + Astro 构建</span>
      <span style="display:flex;gap:18px">
        <a href="https://github.com/pengyuyan3d/resume" target="_blank" rel="noopener noreferrer">本站源码</a>
        <a href={`${base}/resume/`}>A4 简历页</a>
      </span>
    </footer>

    <Panels />
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import { mountIsland3D } from "../scripts/island3d";

      const body = document.body;
      const panels = [...document.querySelectorAll<HTMLElement>(".panel")];
      const triggers = [...document.querySelectorAll<HTMLElement>("[data-zone]")];
      const order = ["work", "build", "campus", "camp"];
      let lastFocus: HTMLElement | null = null;

      const panelOf = (id: string) => panels.find((p) => p.dataset.panel === id) || null;

      function scrollToCase(panel: HTMLElement, caseSlug?: string | null) {
        const bodyEl = panel.querySelector<HTMLElement>(".panel-body");
        if (!bodyEl) return;
        if (!caseSlug) {
          bodyEl.scrollTop = 0;
          return;
        }
        const target = panel.querySelector<HTMLElement>(`#case-${caseSlug}`);
        if (target) {
          window.setTimeout(() => {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            target.classList.remove("is-flash");
            void target.offsetWidth;
            target.classList.add("is-flash");
          }, 80);
        } else {
          bodyEl.scrollTop = 0;
        }
      }

      function openPanel(id: string, caseSlug?: string | null, push = true) {
        const panel = panelOf(id);
        if (!panel) return;
        if (!body.classList.contains("has-panel")) {
          lastFocus = document.activeElement as HTMLElement | null;
        }
        panels.forEach((p) => p.classList.toggle("is-open", p === panel));
        body.classList.add("has-panel");
        triggers.forEach((t) => {
          if (t.hasAttribute("aria-expanded")) {
            t.setAttribute("aria-expanded", String(t.dataset.zone === id));
          }
        });
        scrollToCase(panel, caseSlug);
        window.setTimeout(() => panel.focus({ preventScroll: true }), 60);
        if (push) {
          const url = new URL(window.location.href);
          url.searchParams.set("zone", id);
          if (caseSlug) url.searchParams.set("case", caseSlug);
          else url.searchParams.delete("case");
          history.replaceState(null, "", url);
        }
      }

      function closePanel() {
        const open = panels.find((p) => p.classList.contains("is-open"));
        if (!open) return;
        open.classList.remove("is-open");
        body.classList.remove("has-panel");
        triggers.forEach((t) => {
          if (t.hasAttribute("aria-expanded")) t.setAttribute("aria-expanded", "false");
        });
        const url = new URL(window.location.href);
        url.searchParams.delete("zone");
        url.searchParams.delete("case");
        history.replaceState(null, "", url);
        lastFocus?.focus({ preventScroll: true });
      }

      // Mount Three.js 3D Stylized Floating Island
      const canvas = document.getElementById("island-canvas") as HTMLCanvasElement | null;
      const container = document.getElementById("diorama-container") as HTMLElement | null;
      const markerMap = new Map<string, HTMLElement>();
      document.querySelectorAll<HTMLElement>("[data-marker3d]").forEach((m) => {
        if (m.dataset.marker3d) markerMap.set(m.dataset.marker3d, m);
      });

      let islandApi: { setHighlightZone: (z: string | null) => void } | null = null;
      if (canvas && container) {
        try {
          islandApi = mountIsland3D({
            canvas,
            container,
            markers: markerMap,
            onSelectZone: (zoneId) => openPanel(zoneId),
          });
        } catch (err) {
          console.warn("WebGL fallback:", err);
        }
      }

      triggers.forEach((t) => {
        t.addEventListener("click", () => {
          const zoneId = t.dataset.zone as string;
          const caseSlug = t.dataset.case || null;
          openPanel(zoneId, caseSlug);
        });
        const z = t.dataset.zone;
        if (z && !t.classList.contains("panel-tab")) {
          t.addEventListener("mouseenter", () => islandApi?.setHighlightZone(z));
          t.addEventListener("mouseleave", () => islandApi?.setHighlightZone(null));
        }
      });

      document.querySelectorAll<HTMLElement>("[data-jump]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.jump;
          const target = id ? document.getElementById(id) : null;
          if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            target.classList.remove("is-flash");
            void target.offsetWidth;
            target.classList.add("is-flash");
          }
        });
      });

      document.querySelectorAll("[data-close-panel]").forEach((el) => {
        el.addEventListener("click", closePanel);
      });

      document.addEventListener("keydown", (ev) => {
        const isOpen = body.classList.contains("has-panel");
        if (ev.key === "Escape" && isOpen) {
          ev.preventDefault();
          closePanel();
          return;
        }
        if (isOpen && (ev.key === "ArrowLeft" || ev.key === "ArrowRight")) {
          const cur = panels.findIndex((p) => p.classList.contains("is-open"));
          if (cur >= 0) {
            const next = (cur + (ev.key === "ArrowRight" ? 1 : -1) + order.length) % order.length;
            openPanel(order[next]);
            return;
          }
        }
        if (isOpen && ev.key === "Tab") {
          const panel = panels.find((p) => p.classList.contains("is-open"));
          if (!panel) return;
          const focusables = [
            ...panel.querySelectorAll<HTMLElement>(
              'button, a[href], input, [tabindex]:not([tabindex="-1"])',
            ),
          ].filter((el) => el.offsetParent !== null);
          if (!focusables.length) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (!ev.shiftKey && document.activeElement === last) {
            ev.preventDefault();
            first.focus();
          } else if (ev.shiftKey && document.activeElement === first) {
            ev.preventDefault();
            last.focus();
          }
          return;
        }
        if (isOpen) return;
        const idx = Number(ev.key);
        if (idx >= 1 && idx <= 4) openPanel(order[idx - 1]);
      });

      // 分类筛选器
      const filterChips = [...document.querySelectorAll<HTMLElement>("[data-filter]")];
      const catCards = [...document.querySelectorAll<HTMLElement>("[data-cat]")];
      const subBlocks = [...document.querySelectorAll<HTMLElement>("[data-subblock]")];
      filterChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const f = chip.dataset.filter || "all";
          filterChips.forEach((c) => {
            const active = c === chip;
            c.classList.toggle("is-active", active);
            c.setAttribute("aria-selected", String(active));
          });
          catCards.forEach((card) => {
            const show = f === "all" || card.dataset.cat === f;
            card.style.display = show ? "" : "none";
          });
          subBlocks.forEach((block) => {
            const visibleInBlock = [...block.querySelectorAll<HTMLElement>("[data-cat]")].some(
              (c) => c.style.display !== "none",
            );
            block.style.display = visibleInBlock ? "" : "none";
          });
        });
      });

      // 图片放大灯箱
      const lightbox = document.getElementById("img-lightbox") as HTMLDialogElement | null;
      const lbImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
      document.querySelectorAll<HTMLElement>("[data-zoom-src]").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!lightbox || !lbImg) return;
          lbImg.src = btn.dataset.zoomSrc || "";
          lbImg.alt = btn.dataset.zoomAlt || "";
          lbImg.hidden = false;
          lightbox.showModal();
        });
      });
      document.getElementById("lightbox-close")?.addEventListener("click", () => lightbox?.close());
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) lightbox.close();
      });

      // 顶栏滚动变实
      const header = document.getElementById("header");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 20);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // 深链
      const params = new URLSearchParams(window.location.search);
      const zone = params.get("zone");
      const caseParam = params.get("case");
      if (zone && order.includes(zone)) openPanel(zone, caseParam, false);

      // 复制邮箱
      const toast = document.getElementById("toast");
      let timer: number | undefined;
      document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          if (toast) {
            toast.textContent = `已复制：${text}`;
            toast.classList.add("show");
            window.clearTimeout(timer);
            timer = window.setTimeout(() => toast.classList.remove("show"), 1800);
          }
        });
      });
    </script>
  </body>
</html>
