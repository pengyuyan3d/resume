---
import { siteConfig } from "../config";
import { works } from "../portfolio";
import "../styles/global.css";
import "../styles/island.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const edu = siteConfig.education[0];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteConfig.name} · 长版简历 · 产品型全栈开发工程师</title>
    <meta name="description" content={`${siteConfig.name}的长版简历：企业级 AI 全栈交付、代表作、技能栈与教育背景。`} />
    <meta name="theme-color" content="#faf4e6" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`${siteConfig.name} · 长版简历`} />
    <meta property="og:description" content={`${siteConfig.name}的长版简历：企业级 AI 全栈交付、代表作、技能栈与教育背景。`} />
    <meta property="og:image" content={`${base}/og-cover.jpg`} />
  </head>
  <body class="island-page">
    <header class="site-top fixed inset-x-0 top-0 z-50" id="header">
      <div class="mx-auto flex h-16 max-w-[1560px] items-center justify-between px-6 md:px-10">
        <a href={`${base}/`} class="flex items-baseline gap-2.5">
          <span class="text-[22px]" style="font-family:'Smiley Sans', var(--font-sans)">张雨</span>
          <span class="text-[12px] text-[rgba(34,50,44,0.5)]">长版简历</span>
        </a>
        <nav class="hidden items-center gap-8 text-[13px] text-[rgba(34,50,44,0.62)] md:flex">
          <a class="nav-link hover:text-[#22322c]" href={`${base}/`}>雨岛作品集</a>
          <a class="nav-link hover:text-[#22322c]" href="#projects">项目</a>
          <a class="nav-link hover:text-[#22322c]" href="#experience">经历</a>
        </nav>
        <a class="btn btn-ghost" style="padding:9px 15px;font-size:12.5px;border-radius:2px" href={`${base}/resume.pdf`} download>
          下载一页 PDF
        </a>
      </div>
    </header>

    <main class="pt-16">
      <section class="section" style="padding-bottom:clamp(28px,4vw,44px)">
        <div class="profile-hero">
          <div>
            <h1 class="profile-name">张雨</h1>
            <p class="profile-role">{siteConfig.title}</p>
            <p class="profile-lede">
              把大模型能力与复杂前端交互做成能稳定上线的产品：后端 Python / FastAPI 与 Go，客户端 Vue 3 / React 与 Flutter，交互层支持 Three.js 编译式生成。
            </p>
            <dl class="profile-facts">
              <div>
                <dt>城市</dt>
                <dd>北京</dd>
              </div>
              <div>
                <dt>背景</dt>
                <dd>国家奖学金 · Top 5%</dd>
              </div>
              <div>
                <dt>期望</dt>
                <dd>10–15K</dd>
              </div>
              <div>
                <dt>到岗</dt>
                <dd>2026 届 · 随时</dd>
              </div>
            </dl>
            <p class="profile-links">
              <a href={`${base}/`}>返回雨岛作品集</a>
              <a href={`mailto:${siteConfig.social.email}`}>{siteConfig.social.email}</a>
              <a href="https://github.com/pengyuyan3d" target="_blank" rel="noopener noreferrer">GitHub</a>
            </p>
          </div>
          <figure class="profile-portrait">
            <img src={`${base}/shots/island-card.svg`} alt="雨岛工作站手绘等距海图名片" width="640" height="640" />
          </figure>
        </div>
      </section>

      <section class="section" style="padding-top:0">
        <div class="section-head" style="margin-bottom:26px">
          <h2 class="section-title">关于</h2>
        </div>
        <p class="profile-about">{siteConfig.aboutMe}</p>
      </section>

      <section class="section" id="projects" style="padding-top:0">
        <div class="section-head">
          <div>
            <p class="eyebrow">项目与作品</p>
            <h2 class="section-title">主次分明：双王牌代表作 + 企业生产架构 + 造物小品</h2>
          </div>
          <a class="btn" href={`${base}/?zone=build`}>去作品集看架构细节</a>
        </div>
        <div class="profile-projects">
          {
            works.map((w) => (
              <article class="profile-project">
                <span style="font-size:11px;color:rgba(34,50,44,.45);display:block;margin-bottom:4px">{w.role}</span>
                <h3>{w.name}</h3>
                <p class="profile-project-line">{w.line}</p>
                <p class="profile-project-tags">{w.tags.join(" · ")}</p>
                <p class="profile-project-links">
                  {w.links?.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
                  ))}
                  <a href={`${base}/?zone=build&case=${w.slug}`}>问题与做法 →</a>
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" id="experience" style="padding-top:0">
        <div class="section-head">
          <div>
            <p class="eyebrow">研发经历</p>
            <h2 class="section-title">企业研发与项目交付</h2>
          </div>
        </div>
        {
          siteConfig.experience.map((job, i) => (
            <article class={`entry${i === 0 ? " is-hi" : ""}`} style="padding-bottom:28px">
              <div class="entry-top">
                <div>
                  <h3 class="entry-title">{job.title}</h3>
                  <p class="entry-org">{job.company}</p>
                </div>
              </div>
              <ul class="entry-list">
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="section" style="padding-top:0">
        <div class="profile-two">
          <div>
            <div class="section-head" style="margin-bottom:18px">
              <h2 class="section-title">技能栈</h2>
            </div>
            <div class="tags" style="margin-top:0">
              {siteConfig.skills.map((s) => <span class="tag">{s}</span>)}
            </div>
          </div>
          <div>
            <div class="section-head" style="margin-bottom:18px">
              <h2 class="section-title">教育与获奖</h2>
            </div>
            <p class="profile-edu">
              <strong>{edu.school}</strong> · {edu.degree} · {edu.dateRange}
            </p>
            <ul class="entry-list" style="margin-top:10px">
              {edu.achievements.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section" style="padding-top:0">
        <div class="card" style="padding:clamp(24px,4vw,40px);border-radius:4px;display:flex;gap:24px;align-items:center;justify-content:space-between;flex-wrap:wrap">
          <div>
            <p class="eyebrow">联系</p>
            <h2 style="font-family:'Smiley Sans',var(--font-sans);font-size:clamp(22px,2.6vw,32px);font-weight:400;margin:10px 0 8px">
              随时到岗北京，欢迎约面交流
            </h2>
            <p style="font-size:13.5px;line-height:1.8;color:rgba(34,50,44,.65);margin:0">
              产品型全栈开发 / 企业级 AI 应用 / Python·Go 后端
            </p>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn btn-primary" href={`mailto:${siteConfig.social.email}`}>发邮件</a>
            <a class="btn" href={`${base}/`}>雨岛作品集</a>
            <a class="btn" href={`${base}/resume.pdf`} download>一页 PDF</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© 2026 张雨 · 长版简历</span>
      <span style="display:flex;gap:16px">
        <a href={`${base}/`} class="hover:text-[#22322c]">作品集</a>
        <a href="https://github.com/pengyuyan3d/resume" target="_blank" rel="noopener noreferrer" class="hover:text-[#22322c]">源码</a>
      </span>
    </footer>

    <script is:inline>
      const header = document.getElementById("header");
      const onScroll = () => header?.classList.toggle("is-solid", window.scrollY > 16);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>

    <style>
      .profile-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
        gap: clamp(24px, 4vw, 60px);
        align-items: center;
        padding-top: clamp(24px, 4vw, 52px);
      }
      .profile-name {
        font-family: "Smiley Sans", var(--font-sans);
        font-size: clamp(56px, 7vw, 96px);
        line-height: 0.95;
        margin: 0;
        letter-spacing: 0.01em;
      }
      .profile-role {
        margin: 14px 0 0;
        font-size: 15px;
        font-weight: 600;
        color: #c2492c;
      }
      .profile-lede {
        margin: 18px 0 0;
        font-size: clamp(16px, 1.5vw, 18.5px);
        line-height: 1.75;
        max-width: 32em;
      }
      .profile-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin: 24px 0 0;
        font-size: 13px;
      }
      .profile-links a {
        color: #c2492c;
        text-decoration: none;
        border-bottom: 1px solid rgba(194, 73, 44, 0.35);
        padding-bottom: 1px;
      }
      .profile-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        margin: 26px 0 0;
        max-width: 600px;
        border-top: 1px solid rgba(34, 50, 44, 0.14);
        border-bottom: 1px solid rgba(34, 50, 44, 0.14);
      }
      .profile-facts > div {
        flex: 1;
        min-width: 110px;
        padding: 12px 16px 12px 0;
        border-right: 1px solid rgba(34, 50, 44, 0.08);
      }
      .profile-facts > div:last-child {
        border-right: 0;
        padding-right: 0;
      }
      .profile-facts dt {
        font-size: 11px;
        color: rgba(34, 50, 44, 0.44);
        margin: 0;
      }
      .profile-facts dd {
        margin: 7px 0 0;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }
      .profile-portrait {
        margin: 0;
        max-width: 440px;
        border: 1px solid rgba(34, 50, 44, 0.16);
        background: #fffdf7;
        overflow: hidden;
        box-shadow: 0 24px 48px -34px rgba(34, 50, 44, 0.45);
      }
      .profile-portrait img {
        display: block;
        width: 100%;
        height: auto;
      }
      .profile-about {
        max-width: 48em;
        font-size: 14.5px;
        line-height: 1.95;
        color: rgba(34, 50, 44, 0.8);
        margin: 0;
      }
      .profile-projects {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        border-top: 1px solid rgba(34, 50, 44, 0.14);
        border-left: 1px solid rgba(34, 50, 44, 0.14);
      }
      .profile-project {
        padding: 20px 22px;
        border-right: 1px solid rgba(34, 50, 44, 0.14);
        border-bottom: 1px solid rgba(34, 50, 44, 0.14);
        background: rgba(255, 253, 247, 0.6);
      }
      .profile-project h3 {
        font-size: 16px;
        margin: 0 0 8px;
      }
      .profile-project-line {
        margin: 0;
        font-size: 13px;
        line-height: 1.75;
        color: rgba(34, 50, 44, 0.72);
      }
      .profile-project-tags {
        margin: 10px 0 0;
        font-size: 11.5px;
        color: rgba(34, 50, 44, 0.48);
      }
      .profile-project-links {
        margin: 10px 0 0;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        font-size: 12.5px;
      }
      .profile-project-links a {
        color: #c2492c;
        text-decoration: none;
        border-bottom: 1px solid rgba(194, 73, 44, 0.35);
      }
      .profile-two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(24px, 4vw, 56px);
      }
      .profile-edu {
        margin: 0;
        font-size: 14px;
        line-height: 1.8;
        color: rgba(34, 50, 44, 0.8);
      }
      @media (max-width: 820px) {
        .profile-hero {
          grid-template-columns: 1fr;
        }
        .profile-portrait {
          max-width: 300px;
        }
        .profile-two {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
